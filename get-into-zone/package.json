{
  "name": "browse-hack",
  "displayName": "Browse Hack",
  "version": "0.6.0",
  "description": "Browser automations for Claude: Pinterest, YouTube, Instagram, Midjourney, Suno, DistroKid and Mediamake",
  "author": "subhakar",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^0.546.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "<all_urls>",
      "https://www.midjourney.com/*",
      "https://suno.com/*",
      "http://localhost:3000/*",
      "https://*/*"
    ],
    "permissions": [
      "scripting",
      "storage",
      "activeTab",
      "contextMenus",
      "downloads",
      "offscreen",
      "alarms",
      "identity",
      "identity.email"
    ],
    "background": {
      "service_worker": "background.ts"
    }
  }
}
